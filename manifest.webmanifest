{
  "name": "FuxiaNet 1 · Redazione",
  "short_name": "FuxiaNet 1",
  "description": "La redazione online di Fuxia Magazine, Rete NeTVision e 1Channel.",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0406",
  "theme_color": "#0a0406",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./condividi",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".opus",
            ".ogg",
            ".m4a",
            ".mp3",
            ".aac",
            ".wav",
            ".amr"
          ]
        }
      ]
    }
  }
}
